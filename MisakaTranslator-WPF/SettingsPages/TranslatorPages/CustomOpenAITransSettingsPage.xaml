<Page x:Class="MisakaTranslator_WPF.SettingsPages.TranslatorPages.CustomOpenAITransSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:MisakaTranslator_WPF.SettingsPages.TranslatorPages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="594"
      Title="CustomOpenAITransSettingsPage">

    <Grid>
        <hc:ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Background="White">
                <TextBlock Text="{StaticResource CustomOpenAITransSettingsPage_Introduce}" FontSize="16" Margin="10" TextWrapping="WrapWithOverflow"/>
                <StackPanel Margin="20,20,20,0">
                    <hc:TextBox Name="CustomOpenAIBaseUrlBox" Margin="0,10,0,0" Width="520" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_BaseUrl}" hc:InfoElement.ShowClearButton="True" LostFocus="CustomOpenAISetting_LostFocus" HorizontalAlignment="Left"/>
                    <hc:TextBox Name="CustomOpenAIApiKeyBox" Margin="0,10,0,0" Width="520" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_ApiKey}" hc:InfoElement.ShowClearButton="True" LostFocus="CustomOpenAISetting_LostFocus" HorizontalAlignment="Left"/>
                    <Grid Margin="0,10,0,0" Width="520" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <hc:ComboBox Name="CustomOpenAIModelBox" Grid.Column="0" IsEditable="True" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_ModelName}" LostFocus="CustomOpenAISetting_LostFocus" SelectionChanged="CustomOpenAIModelBox_SelectionChanged"/>
                        <Button Name="CustomOpenAIGetModelsButton" Grid.Column="1" Content="{StaticResource CustomOpenAITransSettingsPage_GetModels}" Margin="10,0,0,0" Width="122" Click="CustomOpenAIGetModelsButton_Click"/>
                    </Grid>
                    <hc:NumericUpDown Name="CustomOpenAITemperatureBox" Minimum="0" Maximum="2" Margin="0,10,0,0" Width="380" Style="{StaticResource NumericUpDownExtend}" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_Temperature}" HorizontalAlignment="Left"/>
                    <hc:TextBox Name="CustomOpenAIPromptTemplateBox" Margin="0,10,0,0" Height="130" hc:InfoElement.TitlePlacement="Top" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_PromptTemplate}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="CustomOpenAISetting_LostFocus"/>
                    <hc:Divider/>
                    <hc:TextBox Name="TestSrcText" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140" hc:InfoElement.Title="{StaticResource CustomOpenAITransSettingsPage_TestSrcText}" hc:InfoElement.ShowClearButton="True" Text="本ソフトウェアのご利用を歓迎します。"/>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="CustomOpenAITestButton" Content="{StaticResource CustomOpenAITransSettingsPage_Test}" Width="122" Click="CustomOpenAITestButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </hc:ScrollViewer>
        <StackPanel hc:Growl.GrowlParent="True" HorizontalAlignment="Right" Margin="15"/>
    </Grid>
</Page>
